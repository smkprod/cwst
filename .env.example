# Скопируй в .env и заполни: cp .env.example .env && nano .env
POSTGRES_PASSWORD=придумай_надёжный_пароль_для_бд
CLASH_ROYALE_API_TOKEN=токен_с_developer.clashroyale.com_с_IP_сервера
TELEGRAM_BOT_TOKEN=токен_бота_от_BotFather

# Необязательно. Адрес, по которому Telegram качает картинки inline-карточек.
# Значение по умолчанию уже прописано в docker-compose.prod.yml — задавайте здесь,
