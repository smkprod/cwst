# Скопируй в .env и заполни: cp .env.example .env && nano .env
POSTGRES_PASSWORD=придумай_надёжный_пароль_для_бд
CLASH_ROYALE_API_TOKEN=токен_с_developer.clashroyale.com_с_IP_сервера
TELEGRAM_BOT_TOKEN=токен_бота_от_BotFather

# Необязательно. Адрес, по которому Telegram качает картинки inline-карточек.
# Значение по умолчанию уже прописано в docker-compose.prod.yml — задавайте здесь,
# только если домен отличается от того, что стоит в Caddyfile.
# PUBLIC_BASE_URL=https://ваш-домен

# Необязательно. Посты из новостей Clash Royale по-русски для канала бота.
# Нужна одна из двух моделей; если заданы обе - работает DeepSeek.
# Без них новости приходят в панель черновиком на английском.
# DeepSeek (ключ на platform.deepseek.com):
# DEEPSEEK_API_KEY=ключ
# Claude (ключ на console.anthropic.com):
# ANTHROPIC_API_KEY=ключ
# ANTHROPIC_MODEL=id_модели
