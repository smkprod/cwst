# === ЭТАП 1: Собираем .NET API ===
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS dotnet-build
WORKDIR /src

# Сначала только csproj — слой restore кэшируется, пока не меняются зависимости.
# Иначе каждое изменение кода = полный restore + рост build cache на сервере.
COPY backend/src/ClanWarTracker.Domain/ClanWarTracker.Domain.csproj backend/src/ClanWarTracker.Domain/
COPY backend/src/ClanWarTracker.Application/ClanWarTracker.Application.csproj backend/src/ClanWarTracker.Application/
COPY backend/src/ClanWarTracker.Infrastructure/ClanWarTracker.Infrastructure.csproj backend/src/ClanWarTracker.Infrastructure/
COPY backend/src/ClanWarTracker.Api/ClanWarTracker.Api.csproj backend/src/ClanWarTracker.Api/
RUN dotnet restore backend/src/ClanWarTracker.Api/ClanWarTracker.Api.csproj

# Теперь исходники и публикация (без повторного restore)
COPY backend/src/ backend/src/
RUN dotnet publish backend/src/ClanWarTracker.Api/ClanWarTracker.Api.csproj -c Release -o /app/publish --no-restore

# === ЭТАП 2: Собираем фронтенд ===
FROM node:20-alpine AS frontend-build
WORKDIR /frontend-src

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# package*.json отдельно — npm ci кэшируется, пока не меняются зависимости
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# === ЭТАП 3: Финальный образ ===
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app

# 1. Скомпилированный C# код из первого этапа
COPY --from=dotnet-build /app/publish .

# 2. Собранный HTML/JS фронтенд из второго этапа в папку wwwroot
COPY --from=frontend-build /frontend-src/dist ./wwwroot

ENV ASPNETCORE_URLS=http://0.0.0.0:10000
EXPOSE 10000

ENTRYPOINT ["dotnet", "ClanWarTracker.Api.dll"]
